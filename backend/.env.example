# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# JWT Configuration (for future implementation)
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:19006

# Base URL used to build absolute URLs for locally-stored uploads (PDFs, etc.).
# In dev this should be your LAN IP so mobile devices can reach it (e.g. http://192.168.x.x:5000).
BASE_URL=http://localhost:5000
