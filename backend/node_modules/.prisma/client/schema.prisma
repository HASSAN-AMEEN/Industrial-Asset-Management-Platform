generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model clients {
  id            String          @id @default(uuid())
  name          String
  contact       String?
  address       String?
  city          String?
  country       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  installations installations[]
  machines      machines[]
  shipments     shipments[]
}

model installations {
  id                                              String             @id @default(uuid())
  machineId                                       String
  clientId                                        String?
  installedAt                                     DateTime           @default(now())
  installedBy                                     String
  latitude                                        Float?
  longitude                                       Float?
  siteAddress                                     String?
  siteNotes                                       String?
  status                                          InstallationStatus @default(ACTIVE)
  createdAt                                       DateTime           @default(now())
  updatedAt                                       DateTime           @updatedAt
  clients                                         clients?           @relation(fields: [clientId], references: [id])
  machines_installations_machineIdTomachines      machines           @relation("installations_machineIdTomachines", fields: [machineId], references: [id])
  machines_machines_installationIdToinstallations machines[]         @relation("machines_installationIdToinstallations")
}

model machine_status_history {
  id         String   @id @default(uuid())
  machineId  String
  fromStatus String
  toStatus   String
  changedBy  String
  comment    String?
  createdAt  DateTime @default(now())
  machines   machines @relation(fields: [machineId], references: [id])
}

model machines {
  id                                                   String                   @id @default(uuid())
  serialNumber                                         String                   @unique
  model                                                String
  category                                             String
  purchaseDate                                         DateTime?
  cost                                                 Decimal?
  status                                               String                   @default("IN_WAREHOUSE")
  warehouseId                                          String
  clientId                                             String?
  createdAt                                            DateTime                 @default(now())
  updatedAt                                            DateTime                 @updatedAt
  installationId                                       String?
  installations_installations_machineIdTomachines      installations[]          @relation("installations_machineIdTomachines")
  machine_status_history                               machine_status_history[]
  clients                                              clients?                 @relation(fields: [clientId], references: [id])
  installations_machines_installationIdToinstallations installations?           @relation("machines_installationIdToinstallations", fields: [installationId], references: [id])
  warehouses                                           warehouses               @relation(fields: [warehouseId], references: [id])
  shipment_items                                       shipment_items[]
}

model shipment_items {
  id         String    @id @default(uuid())
  shipmentId String
  machineId  String
  createdAt  DateTime  @default(now())
  machines   machines  @relation(fields: [machineId], references: [id])
  shipments  shipments @relation(fields: [shipmentId], references: [id])

  @@unique([shipmentId, machineId])
  @@index([machineId])
}

model shipment_status_history {
  id         String         @id @default(uuid())
  shipmentId String
  fromStatus ShipmentStatus
  toStatus   ShipmentStatus
  changedBy  String
  comment    String?
  createdAt  DateTime       @default(now())
  shipments  shipments      @relation(fields: [shipmentId], references: [id])
}

model shipments {
  id                                               String                    @id @default(uuid())
  fromWarehouseId                                  String
  toWarehouseId                                    String?
  toClientId                                       String?
  shipmentDate                                     DateTime                  @default(now())
  expectedDeliveryDate                             DateTime?
  status                                           ShipmentStatus            @default(CREATED)
  deliveryConfirmation                             String?
  updatedBy                                        String
  notes                                            String?
  createdAt                                        DateTime                  @default(now())
  updatedAt                                        DateTime                  @updatedAt
  trackingId                                       String?                   @unique
  shipment_items                                   shipment_items[]
  shipment_status_history                          shipment_status_history[]
  warehouses_shipments_fromWarehouseIdTowarehouses warehouses                @relation("shipments_fromWarehouseIdTowarehouses", fields: [fromWarehouseId], references: [id])
  clients                                          clients?                  @relation(fields: [toClientId], references: [id])
  warehouses_shipments_toWarehouseIdTowarehouses   warehouses?               @relation("shipments_toWarehouseIdTowarehouses", fields: [toWarehouseId], references: [id])
}

model users {
  id                        String               @id @default(uuid())
  email                     String               @unique
  password                  String
  contact                   String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  warehouseId               String?
  role                      UserRole             @default(SALES_OPS)
  warehouses                warehouses?          @relation(fields: [warehouseId], references: [id])
  trainingMaterialsUploaded training_materials[] @relation("uploadedByUser")
}

model warehouses {
  id                                              String      @id @default(uuid())
  name                                            String
  address                                         String
  city                                            String
  manager                                         String?
  contact                                         String?
  capacity                                        Int?
  createdAt                                       DateTime    @default(now())
  updatedAt                                       DateTime    @updatedAt
  machines                                        machines[]
  shipments_shipments_fromWarehouseIdTowarehouses shipments[] @relation("shipments_fromWarehouseIdTowarehouses")
  shipments_shipments_toWarehouseIdTowarehouses   shipments[] @relation("shipments_toWarehouseIdTowarehouses")
  users                                           users[]
}

model training_materials {
  id           String               @id @default(uuid())
  title        String
  machineModel String
  description  String?
  type         TrainingMaterialType
  videoUrl     String?
  pdfUrl       String?
  thumbnailUrl String?
  uploadedBy   String
  createdAt    DateTime             @default(now())

  uploadedByUser users @relation("uploadedByUser", fields: [uploadedBy], references: [id])

  @@map("training_materials")
}

enum InstallationStatus {
  ACTIVE
  REMOVED
  MAINTENANCE
}

enum TrainingMaterialType {
  VIDEO
  PDF
}

enum ShipmentStatus {
  CREATED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  WAREHOUSE_MANAGER
  SALES_OPS
  TECHNICIAN
}
