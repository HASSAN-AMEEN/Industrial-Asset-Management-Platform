PORT=5000
NODE_ENV=development

# Use the Neon DIRECT (non-pooler) endpoint. Prisma interactive transactions
# ($transaction) are unreliable over the PgBouncer "-pooler" endpoint
# ("Transaction not found" errors on INSTALLED/shipment flows). The pooled URL is
# kept below for reference if a connection-pooled setup is needed later.
DATABASE_URL="postgresql://neondb_owner:npg_SUfD4bTrJ0uq@ep-tiny-bar-ai7vrzxt.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Pooled (PgBouncer) endpoint — do NOT use for the app's interactive transactions:
# DATABASE_URL_POOLED="postgresql://neondb_owner:npg_SUfD4bTrJ0uq@ep-tiny-bar-ai7vrzxt-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT (for future implementation)
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://192.168.2.105:19006

# Base URL used to build absolute URLs for locally-stored uploads (PDFs, etc.).
# Must be reachable from the mobile device on the LAN.
BASE_URL=http://192.168.2.105:5000
