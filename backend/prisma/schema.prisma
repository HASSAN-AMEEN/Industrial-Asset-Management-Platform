generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  warehouseId String?
  role        UserRole   @default(SALES_OPS)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@map("users")
}

model Warehouse {
  id        String    @id @default(uuid())
  name      String
  address   String
  city      String
  manager   String?
  contact   String?
  capacity  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  machines  Machine[]
  users     User[]
  shipmentsFrom Shipment[] @relation("ShipmentFromWarehouse")
  shipmentsTo   Shipment[] @relation("ShipmentToWarehouse")

  @@map("warehouses")
}

model Machine {
  id                   String                 @id @default(uuid())
  serialNumber         String                 @unique
  model                String
  category             String
  purchaseDate         DateTime?
  cost                 Decimal?
  status               String                 @default("IN_WAREHOUSE")
  warehouseId          String
  clientId             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  installationId       String?
  installations        Installation[]         @relation("MachineInstallations")
  installation         Installation?          @relation("MachineSelectedInstallation", fields: [installationId], references: [id])
  statusHistory        MachineStatusHistory[]
  shipmentItems        ShipmentItem[]
  client               Client?                @relation(fields: [clientId], references: [id])
  warehouse            Warehouse              @relation(fields: [warehouseId], references: [id])

  @@map("machines")
}

model Client {
  id            String         @id @default(uuid())
  name          String
  contact       String?
  address       String?
  city          String?
  country       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  machines      Machine[]
  shipments     Shipment[]
  installations Installation[]

  @@map("clients")
}

model Shipment {
  id                   String               @id @default(uuid())
  trackingId           String?              @unique
  fromWarehouseId       String
  toWarehouseId         String?
  toClientId            String?
  shipmentDate          DateTime             @default(now())
  expectedDeliveryDate  DateTime?
  status                ShipmentStatus       @default(CREATED)
  deliveryConfirmation  String?
  updatedBy             String
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  items                 ShipmentItem[]
  fromWarehouse         Warehouse            @relation("ShipmentFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse           Warehouse?           @relation("ShipmentToWarehouse", fields: [toWarehouseId], references: [id])
  toClient              Client?              @relation(fields: [toClientId], references: [id])
  statusHistory         ShipmentStatusHistory[]

  @@map("shipments")
}

model ShipmentItem {
  id         String   @id @default(uuid())
  shipmentId String
  machineId  String
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])
  machine  Machine  @relation(fields: [machineId], references: [id])

  @@unique([shipmentId, machineId])
  @@index([machineId])
  @@map("shipment_items")
}

model ShipmentStatusHistory {
  id         String         @id @default(uuid())
  shipmentId String
  fromStatus ShipmentStatus
  toStatus   ShipmentStatus
  changedBy  String
  comment    String?
  createdAt  DateTime       @default(now())

  shipment   Shipment       @relation(fields: [shipmentId], references: [id])

  @@map("shipment_status_history")
}

model MachineStatusHistory {
  id         String   @id @default(uuid())
  machineId  String
  fromStatus String
  toStatus   String
  changedBy  String
  comment    String?
  createdAt  DateTime @default(now())
  machine    Machine  @relation(fields: [machineId], references: [id])

  @@map("machine_status_history")
}

enum UserRole {
  SUPER_ADMIN
  WAREHOUSE_MANAGER
  SALES_OPS
  TECHNICIAN
}

enum ShipmentStatus {
  CREATED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum InstallationStatus {
  ACTIVE
  REMOVED
  MAINTENANCE
}

model Installation {
  id           String             @id @default(uuid())
  machineId    String
  clientId     String?
  installedAt  DateTime           @default(now())
  installedBy  String
  latitude     Float?
  longitude    Float?
  siteAddress  String?
  siteNotes    String?
  status       InstallationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  machine   Machine   @relation("MachineInstallations", fields: [machineId], references: [id])
  client    Client?   @relation(fields: [clientId], references: [id])
  machines  Machine[] @relation("MachineSelectedInstallation")

  @@map("installations")
}
