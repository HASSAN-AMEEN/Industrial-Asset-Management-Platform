generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  warehouseId String?
  role        UserRole   @default(SALES_OPS)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@map("users")
}

model Warehouse {
  id        String    @id @default(uuid())
  name      String
  address   String
  city      String
  manager   String?
  contact   String?
  capacity  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  machines  Machine[]
  users     User[]

  @@map("warehouses")
}

model Machine {
  id                   String                 @id @default(uuid())
  serialNumber         String                 @unique
  model                String
  category             String
  purchaseDate         DateTime?
  cost                 Decimal?
  status               String                 @default("IN_WAREHOUSE")
  warehouseId          String
  clientId             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  installationLocation String?
  statusHistory        MachineStatusHistory[]
  client               Client?                @relation(fields: [clientId], references: [id])
  warehouse            Warehouse              @relation(fields: [warehouseId], references: [id])

  @@map("machines")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  contact   String?
  address   String?
  city      String?
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  machines  Machine[]

  @@map("clients")
}

model MachineStatusHistory {
  id         String   @id @default(uuid())
  machineId  String
  fromStatus String
  toStatus   String
  changedBy  String
  comment    String?
  createdAt  DateTime @default(now())
  machine    Machine  @relation(fields: [machineId], references: [id])

  @@map("machine_status_history")
}

enum UserRole {
  SUPER_ADMIN
  WAREHOUSE_MANAGER
  SALES_OPS
  TECHNICIAN
}
